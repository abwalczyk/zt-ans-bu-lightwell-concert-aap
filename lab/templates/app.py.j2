#!/usr/bin/env python3
"""
Flask API Application - Concert + AAP + Lightwell Lab
Vulnerable to CVE-2026-52891 (PyYAML deserialization)
"""

from flask import Flask, request, jsonify
import yaml
import pkg_resources

app = Flask(__name__)

@app.route('/')
def index():
    return jsonify({
        "name": "Flask API Application",
        "version": "1.0.0",
        "lab": "Concert + AAP + Lightwell CVE Remediation"
    })

@app.route('/health')
def health():
    """Health check endpoint with PyYAML version"""
    pyyaml_version = pkg_resources.get_distribution("pyyaml").version
    return jsonify({
        "status": "healthy",
        "pyyaml_version": pyyaml_version,
        "python_version": "3.11"
    })

@app.route('/api/parse-yaml', methods=['POST'])
def parse_yaml():
    """
    YAML parsing endpoint
    VULNERABLE when using PyYAML < 6.0.2 with unsafe loaders
    """
    try:
        yaml_data = request.get_data(as_text=True)

        # Check PyYAML version
        pyyaml_version = pkg_resources.get_distribution("pyyaml").version

        # In vulnerable versions (<6.0), yaml.load() uses unsafe loader
        # In fixed versions (>=6.0.2), yaml.load() is safe by default
        parsed = yaml.safe_load(yaml_data)

        return jsonify({
            "parsed": parsed,
            "pyyaml_version": pyyaml_version
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 400

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=False)
